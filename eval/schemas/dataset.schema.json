{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vortex evaluation dataset",
  "type": "object",
  "required": ["schema_version", "chunks", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "chunks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text"], "properties": {
      "id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, "text": {"type": "string", "minLength": 1}
    }}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["query_id", "query", "relevant_chunk_ids"], "properties": {
      "query_id": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1},
      "relevant_chunk_ids": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "integer", "minimum": 0}},
      "reference_answer": {"type": ["string", "null"]}, "grades": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 30}},
      "metadata": {"type": "object"}
    }}}
  }
}
